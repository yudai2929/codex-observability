      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Requests by client",
          "description": "API and WebSocket requests grouped by the Codex client that emitted the samples. This is a local-client breakdown, not a team-member breakdown.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (originator) (label_replace(last_over_time(codex_api_request_total[$__range]), \"request_transport\", \"API\", \"__name__\", \".*\") or label_replace(last_over_time(codex_websocket_request_total[$__range]), \"request_transport\", \"WebSocket\", \"__name__\", \".*\")) or on() label_replace(vector(0), \"originator\", \"No activity\", \"\", \"\")",
                        "instant": true,
                        "legendFormat": "{{originator}}",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
