      "panel-9": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Avg request latency",
          "description": "Average from the latest cumulative histogram snapshots in the selected time range. Displays 0 until Codex reports a measurement.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "(sum(last_over_time(codex_websocket_request_duration_ms_milliseconds_sum[$__range])) / clamp_min(sum(last_over_time(codex_websocket_request_duration_ms_milliseconds_count[$__range])), 1)) or vector(0)",
                        "instant": true,
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
