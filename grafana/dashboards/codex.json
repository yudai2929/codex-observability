      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "API request latency",
          "description": "Average and estimated 95th percentile latency across HTTP and WebSocket requests. Requires consecutive reports.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(rate({__name__=~\"codex_(api|websocket)_request_duration_ms_milliseconds_sum\"}[$__rate_interval])) / sum(rate({__name__=~\"codex_(api|websocket)_request_duration_ms_milliseconds_count\"}[$__rate_interval]))",
                        "instant": false,
                        "legendFormat": "Avg",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=~\"codex_(api|websocket)_request_duration_ms_milliseconds_bucket\"}[$__rate_interval])))",
                        "instant": false,
                        "legendFormat": "P95",
                        "range": true
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "right",
                  "showLegend": true,
                  "calcs": [
                    "lastNotNull"
                  ]
                },
                "tooltip": {
                  "mode": "",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ms",
                  "min": 0,
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Requests by client",
          "description": "This panel replaces the team member breakdown in the hosted dashboard. It shows requests by the originating Codex client. Last cumulative value observed in the selected time range; this is not the increase during that range.",
