      "panel-16": {
        "kind": "Panel",
        "spec": {
          "id": 16,
          "title": "Codex traces",
          "description": "Codex spans in the selected time range. This table fills when Codex has emitted traces; metric panels remain useful even when there are no spans.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "tempo",
                      "version": "v0",
                      "datasource": {
                        "name": "tempo"
                      },
                      "spec": {
                        "queryType": "traceql",
                        "query": "{resource.service.name=~\"[Cc]odex.*\"}",
                        "limit": 100,
                        "filters": [],
                        "tableType": "traces"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
