                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (app_version) (last_over_time(codex_thread_started_total[$__range])) \u003e 0",
                        "instant": true,
                        "legendFormat": "{{app_version}}",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "piechart",
            "version": "",
            "spec": {
              "options": {
                "pieType": "donut",
                "tooltip": {
                  "mode": "",
                  "sort": ""
                },
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ]
                },
                "legend": {
                  "values": [
                    "value",
