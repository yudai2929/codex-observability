{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "codex-otel-local"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Off",
    "description": "A local view inspired by Grafana's OpenAI Codex Overview. Codex OTel metrics do not include team member identities, so the dashboard shows the originating client instead. Stat panels and breakdowns show the last cumulative value observed in the selected time range.",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Total requests",
          "description": "Last cumulative value observed in the selected time range; this is not the increase during that range. Combined HTTP and WebSocket requests.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(last_over_time({__name__=~\"codex_(api|websocket)_request_total\"}[$__range]))",
                        "instant": true,
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "none",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "noValue": "No data"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Auth mode",
          "description": "Authentication mode recorded when a thread starts. Last cumulative value observed in the selected time range; this is not the increase during that range.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (auth_mode) (last_over_time(codex_thread_started_total[$__range])) \u003e 0",
                        "instant": true,
                        "legendFormat": "{{auth_mode}}",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "piechart",
            "version": "",
            "spec": {
              "options": {
                "pieType": "donut",
                "tooltip": {
                  "mode": "",
                  "sort": ""
                },
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ]
                },
                "legend": {
                  "values": [
                    "value",
                    "percent"
                  ],
                  "displayMode": "table",
                  "placement": "right",
                  "showLegend": true,
                  "calcs": []
                },
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-11": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Terminal type",
          "description": "Client type that started the thread, using the Codex OTel session_source attribute. Last cumulative value observed in the selected time range; this is not the increase during that range.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
