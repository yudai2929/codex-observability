                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (session_source) (last_over_time(codex_thread_started_total[$__range])) or on() label_replace(vector(0), \"session_source\", \"No activity\", \"\", \"\")",
                        "instant": true,
                        "legendFormat": "{{session_source}}",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "piechart",
            "version": "",
            "spec": {
              "options": {
                "pieType": "donut",
                "tooltip": {
                  "mode": "",
                  "sort": ""
                },
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ]
                },
                "legend": {
                  "values": [
                    "value",
                    "percent"
                  ],
                  "displayMode": "table",
                  "placement": "right",
                  "showLegend": true,
                  "calcs": []
                },
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {}
                },
                "overrides": []
